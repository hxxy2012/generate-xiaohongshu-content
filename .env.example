# RedBookAI 环境配置示例文件
# 请复制此文件为 .env 并填写实际配置

APP_DEBUG = true

[APP]
DEFAULT_TIMEZONE = Asia/Shanghai

[DATABASE]
TYPE = mysql
HOSTNAME = 127.0.0.1
DATABASE = redbook_ai
USERNAME = root
PASSWORD =
HOSTPORT = 3306
CHARSET = utf8mb4
PREFIX = rb_

[CACHE]
DRIVER = file

[GEMINI]
# Gemini API Key（必填）- 在 https://makersuite.google.com/app/apikey 获取
API_KEY = your_gemini_api_key_here
# Gemini API地址
API_URL = https://generativelanguage.googleapis.com/v1beta
# 模型选择：gemini-1.5-pro 或 gemini-1.5-flash
MODEL = gemini-1.5-flash
# 请求超时时间（秒）
TIMEOUT = 60
# 最大重试次数
MAX_RETRIES = 3
# 温度参数（0-2）
TEMPERATURE = 0.9

[SESSION]
TYPE = file
EXPIRE = 86400
PREFIX = redbook_session_
