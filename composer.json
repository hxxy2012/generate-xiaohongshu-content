{
    "name": "redbook-ai/content-generator",
    "description": "RedBookAI - 小红书AI创作助手",
    "type": "project",
    "keywords": ["thinkphp", "AI", "xiaohongshu", "content-generator"],
    "license": "MIT",
    "require": {
        "php": ">=8.0",
        "topthink/framework": "^8.0",
        "topthink/think-orm": "^3.0",
        "topthink/think-view": "^2.0",
        "topthink/think-multi-app": "^1.0",
        "topthink/think-queue": "^3.0",
        "predis/predis": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "app\\": "app/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "@php think service:discover",
            "@php think vendor:publish"
        ]
    },
    "config": {
        "preferred-install": "dist",
        "allow-plugins": {
            "topthink/think-installer": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
